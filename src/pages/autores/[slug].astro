---
import SEO from '../../components/SEO.astro';
import '../../styles/mobile-polish.css';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { livros, futuras } from '../../data/livros';
import luiz from '../../data/editorial/luiz.json';
import heloisa from '../../data/editorial/heloisa.json';
import t from '../../data/editorial/perfil.json';
import g from '../../data/editorial/geral.json';

const pessoas = [
 { slug: 'luiz-anselmo', pessoa: 'ele', foto: '/imagens/luiz-anselmo.jpg', cor:'#53675A', ...luiz },
 { slug: 'heloisa-marques', pessoa: 'ela', foto: '/imagens/heloisa-marques.jpg', cor:'#884C55', ...heloisa },
] as const;
export function getStaticPaths() {
  // Caminhos fixos; nomes, frases e biografias são gerenciados pelo CMS.
  // Esta lista precisa ser declarada dentro de getStaticPaths no build do Astro.
  const perfis = [
    { slug: 'luiz-anselmo', pessoa: 'ele', foto: '/imagens/luiz-anselmo.jpg', cor: '#53675A', ...luiz },
    { slug: 'heloisa-marques', pessoa: 'ela', foto: '/imagens/heloisa-marques.jpg', cor: '#884C55', ...heloisa }
  ];
  return perfis.map(perfil => ({ params: { slug: perfil.slug }, props: { perfil } }));
}
const { perfil } = Astro.props;
const meusLivros = livros.filter(l=>l.leitores.includes(perfil.pessoa));
const meusFuturos = futuras.filter(l=>l.interesses.includes(perfil.pessoa));
const avaliados = meusLivros.filter(l=>perfil.pessoa === 'ele' ? l.notaEle !== null : l.notaEla !== null);
const media = avaliados.length ? (avaliados.reduce((acc,l)=>acc+(perfil.pessoa === 'ele' ? (l.notaEle ?? 0) : (l.notaEla ?? 0)),0)/avaliados.length).toFixed(1).replace('.',',') : '—';
const duplas = meusLivros.filter(l=>l.leitores.length===2).length;
const outro = pessoas.find(p=>p.slug!==perfil.slug)!;
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/><link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="description" content={`Conheça ${perfil.nome} e suas leituras no ${g.tituloSite}.`}/>
<title>{perfil.nome} — {g.tituloSite}</title>
  <SEO title={`${perfil.nome} — ${g.tituloSite}`} description={`Conheça ${perfil.nome} e suas leituras no ${g.tituloSite}.`} />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body style={`--destaque:${perfil.cor}`}>
<Header />
<main id="conteudo-principal">
<section class="hero container">
<div class="retrato"><img src={perfil.foto} alt={`Retrato de ${perfil.nome}`} width="640" height="640" loading="eager"/></div>
<div class="apresentacao"><p class="rotulo">{perfil.titulo.toUpperCase()}</p><h1>{perfil.nome}</h1><div class="frase">“{perfil.frase}”</div><div class="texto texto-paragrafos">
  {perfil.descricao
    .split(/\r?\n\s*\r?\n/)
    .map((paragrafo: string) => paragrafo.trim())
    .filter(Boolean)
    .map((paragrafo: string) => <p>{paragrafo}</p>)}
</div><a class="link" href="#minhas-leituras">{t.linkLeituras} <span aria-hidden="true">↘</span></a></div>
</section>
<section class="numeros"><div class="container estatisticas"><div><strong>{meusLivros.length}</strong><span>{t.estatLivros}</span></div><div><strong>{media}</strong><span>{t.estatMedia}</span></div><div><strong>{duplas}</strong><span>{t.estatDuplas}</span></div></div></section>
<section class="container historia"><div><p class="rotulo">{t.rotuloHistoria}</p><h2>{t.tituloHistoria1} <em>{t.tituloHistoria2}</em></h2></div><div>{perfil.biografia.split(/\n\s*\n/).filter(Boolean).map(paragrafo => <p>{paragrafo}</p>)}</div></section>
<section id="minhas-leituras" class="leituras"><div class="container"><div class="cabeca-secao"><div><p class="rotulo">{t.rotuloLeituras}</p><h2>{t.tituloLeituras1} <em>{t.tituloLeituras2}</em></h2><p>{t.descricaoLeiturasAntes} {perfil.nome}. {t.descricaoLeiturasDepois}</p></div><a href="/estante">{t.linkEstante} ↗</a></div>
<div class="grade">
{meusLivros.map(l=><article class="livro"><a href={`/livros/${l.id}`} class="capa" style={`--capa:${l.cor}`} aria-label={`${g.ariaVerLivro} ${l.titulo}`}>{l.capa && <img class="capa-imagem" src={l.capa} alt="" loading="lazy" onerror="this.remove()" onload="if(this.naturalWidth < 50) this.remove()" />}<span>{g.rotuloCapa}</span><strong>{l.titulo}</strong><small>{l.autor}</small></a><div class="livro-info"><p class="categoria">{l.genero} {l.leitores.length===2?`· ${g.leituraDupla.toUpperCase()}`:''}</p><h3><a href={`/livros/${l.id}`}>{l.titulo}</a></h3><p class="autor">{l.autor}</p><p class="nota">{t.minhaAvaliacao} <b>{(perfil.pessoa==='ele'? l.notaEle : l.notaEla)?.toFixed(1).replace('.',',') ?? '—'}{(perfil.pessoa==='ele'? l.notaEle : l.notaEla) === null ? '' : '/5'}</b></p><a class="link-opiniao" href={`/livros/${l.id}/${perfil.pessoa}`}>{t.linkOpiniao} ↗</a></div></article>)}
</div>{meusLivros.length===0 && <p class="aviso">{t.estanteVazia}</p>}</div></section>
<section class="futuras-perfil"><div class="container">
  <div class="futuras-topo"><div><p class="rotulo">{t.futurasRotulo}</p><h2>{t.futurasTitulo}</h2><p>{t.futurasDescricao}</p></div>
    <a class="link-futuras" href={`/proximas-leituras?leitor=${perfil.pessoa}`}>{t.futurasVerTodas} ↗</a>
  </div>
  {meusFuturos.length ? <div class="futuras-grade">{meusFuturos.map(l=><article class="futuro-livro"><span class="marca-futuro">✦</span><h3>{l.titulo}</h3><p>{l.autor}</p>{l.leitores.length > 0 && <a href={`/livros/${l.id}`}>{g.ariaVerLivro} {l.titulo} ↗</a>}</article>)}</div> : <p class="aviso">{t.futurasVazio}</p>}
</div></section>
<section class="outro"><div class="container outro-conteudo"><p class="rotulo">{t.rotuloOutro}</p><h2>{t.tituloOutro1} <em>{t.tituloOutro2}</em></h2><p>{t.descricaoOutroAntes} {outro.nome}.</p><a href={`/autores/${outro.slug}`}><img src={outro.foto} alt="" width="52" height="52"/>{t.linkOutro} {outro.nome} ↗</a></div></section>
</main><Footer />
</body></html>
<style>
:global(*){box-sizing:border-box}:global(html){scroll-behavior:smooth}:global(body){margin:0;background:#F5F0E8;color:#312E2B;font-family:'DM Sans',sans-serif;-webkit-font-smoothing:antialiased}:global(a){color:inherit;text-decoration:none}.container{width:min(1120px,calc(100% - 48px));margin-inline:auto}.cabecalho{border-bottom:1px solid #ded4c6}.topo{min-height:98px;display:flex;align-items:center;justify-content:space-between;gap:20px}.marca{display:flex;align-items:center;gap:10px;font:600 25px/1 'Playfair Display',serif;white-space:nowrap}.marca small{display:block;font-size:18px}.simbolo{display:flex;gap:5px}.simbolo i{height:11px;width:11px;border-radius:50%;background:#53675A}.simbolo i+i{background:#884C55}nav{display:flex;gap:27px;font-size:13px;font-weight:600}nav a:hover{color:var(--destaque)}.hero{display:grid;grid-template-columns:0.85fr 1.15fr;gap:88px;align-items:center;padding:95px 0 100px}.retrato{max-width:410px;aspect-ratio:4/5;overflow:hidden;border-radius:4px;box-shadow:20px 20px 0 #E8E0D3}.retrato img{width:100%;height:100%;object-fit:cover;object-position:center}.rotulo{font-size:11px;font-weight:700;letter-spacing:2.4px;color:var(--destaque)}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:'Playfair Display',serif}h1{font-size:clamp(45px,6vw,78px);font-weight:500;line-height:1.12;margin:20px 0 27px}h2{font-size:clamp(33px,4vw,52px);font-weight:500;line-height:1.24;margin:15px 0 24px}h2 em{color:var(--destaque);font-weight:400}.frase{font:italic 21px/1.6 'Playfair Display',serif;color:var(--destaque);margin-bottom:28px}.texto,.historia p:not(.rotulo){font-size:15px;line-height:2;color:#736b61}.link{display:inline-block;font-size:13px;font-weight:700;margin-top:20px;border-bottom:1px solid var(--destaque);padding-bottom:7px;color:var(--destaque)}.numeros{background:#EAE3D8;padding:38px 0}.estatisticas{display:grid;grid-template-columns:repeat(3,1fr);text-align:center;gap:15px}.estatisticas div{border-right:1px solid #D7CABB}.estatisticas div:last-child{border:0}.estatisticas strong{display:block;font:500 39px 'Playfair Display',serif}.estatisticas span{display:block;color:#7c7368;font-size:12px;margin-top:4px}.historia{display:grid;grid-template-columns:1fr 1fr;gap:90px;padding-top:95px;padding-bottom:100px}.aviso{font-size:11px;color:#897d70}.leituras{background:#FAF7F1;padding:84px 0 105px}.cabeca-secao{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:34px}.cabeca-secao h2{margin-bottom:10px}.cabeca-secao p:not(.rotulo){font-size:14px;line-height:1.8;color:#766f66;max-width:550px}.cabeca-secao>a{font-size:13px;color:var(--destaque);font-weight:700;white-space:nowrap;margin-bottom:15px}.grade{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:25px}.livro{border:1px solid #E8DDD1;background:#fff}.capa{min-height:270px;background:var(--capa);color:#f9f1e6;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:25px;gap:18px;text-align:center;position:relative}.capa:after{content:'';position:absolute;inset:14px;border:1px solid #ffffff66;pointer-events:none}.capa span{font-size:9px;letter-spacing:2px}.capa strong{font:500 27px/1.2 'Playfair Display',serif}.capa small{font-size:11px}.livro-info{padding:24px}.categoria{font-size:10px;letter-spacing:1.2px;color:var(--destaque);font-weight:700}.livro h3{font-size:23px;font-weight:500;margin:12px 0 5px}.autor{font-size:12px;color:#81776e}.nota{font-size:13px;padding:13px 0;border-top:1px solid #EEE4D9;margin:19px 0 6px}.link-opiniao{display:inline-block;font-weight:700;color:var(--destaque);font-size:13px;margin-top:6px}.outro{background:#EAE3D8;padding:80px 0;text-align:center}.outro-conteudo{max-width:650px}.outro p:not(.rotulo){font-size:14px;color:#736b61;line-height:1.8}.outro a{display:inline-flex;align-items:center;gap:12px;border-bottom:1px solid var(--destaque);padding:8px 0;font-size:13px;font-weight:700;color:var(--destaque)}.outro a img{height:52px;width:52px;object-fit:cover;border-radius:50%}footer{background:#312E2B;color:#F5F0E8}.rodape{min-height:94px;display:flex;align-items:center;justify-content:space-between;gap:20px}.rodape>span{font:500 19px 'Playfair Display',serif}.ponto{color:#CB8F96}footer small{font-size:11px;letter-spacing:1px;color:#CBBFB3}@media(max-width:850px){.topo{flex-direction:column;padding:18px 0}nav{flex-wrap:wrap;justify-content:center;gap:15px}.hero{gap:35px;padding:65px 0}.historia{gap:35px}.grade{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:610px){.container{width:calc(100% - 32px)}.hero{grid-template-columns:1fr;gap:50px}.retrato{max-width:75%;margin:auto}.apresentacao{text-align:center}.historia{grid-template-columns:1fr;padding:62px 0;gap:20px}.estatisticas strong{font-size:29px}.cabeca-secao{flex-direction:column;align-items:start}.grade{grid-template-columns:1fr}.capa{min-height:270px}.rodape{flex-direction:column;padding:26px;text-align:center;justify-content:center}nav{font-size:11px;gap:11px}}
</style>

<style>
  .futuras-perfil{padding:69px 0 78px;background:#F5F0E8}
  .futuras-topo{display:flex;justify-content:space-between;align-items:end;gap:24px;margin-bottom:28px}
  .futuras-topo h2{margin:4px 0 10px}
  .futuras-topo p:not(.rotulo){font:14px/1.75 'DM Sans',sans-serif;color:#766e65;margin:0}
  .link-futuras{font-size:13px;font-weight:700;color:var(--destaque);white-space:nowrap;margin-bottom:9px}
  .futuras-grade{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:17px}
  .futuro-livro{background:#fffaf3;border:1px solid #e3d7c8;border-radius:6px;padding:22px 24px;min-height:145px}
  .marca-futuro{color:var(--destaque);font-size:22px}.futuro-livro h3{font-size:21px;font-weight:500;line-height:1.3;margin:12px 0 7px}
  .futuro-livro p{font-size:13px;color:#83786e;margin:0 0 12px}.futuro-livro a{font-size:12px;color:var(--destaque);font-weight:700}
  @media(max-width:800px){.futuras-grade{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:610px){.futuras-perfil{padding:46px 0 55px}.futuras-topo{align-items:start;flex-direction:column;gap:10px}.futuras-grade{grid-template-columns:1fr}.futuro-livro{min-height:0}}
</style>

<style>
  .texto-paragrafos > p { margin: 0 0 18px; }
  .texto-paragrafos > p:last-child { margin-bottom: 0; }
</style>

<style>
/* Edição mobile dos perfis — apenas telas até 700px.
   Não modifica o visual desktop nem os dados editados no Pages CMS. */
@media (max-width:700px) {
  main .hero.container {
    display: grid !important;
    grid-template-columns: clamp(88px, 24vw, 116px) minmax(0, 1fr);
    grid-template-rows: auto auto auto auto auto;
    align-items: center;
    justify-content: stretch;
    column-gap: 20px;
    row-gap: 0;
    width: calc(100% - 40px);
    max-width: 520px;
    padding: 30px 0 39px;
    margin-inline: auto;
    text-align: left;
    min-height: 0;
  }
  main .hero .retrato {
    grid-column: 1;
    grid-row: 1 / span 2;
    width: 100%;
    max-width: none;
    margin: 0;
    aspect-ratio: 4/5;
    border-radius: 6px;
    box-shadow: 8px 8px 0 #e8e0d3;
  }
  main .hero .retrato img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }
  main .hero .apresentacao {
    display: contents;
  }
  main .hero .apresentacao > .rotulo {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
    margin: 0 0 5px;
    font-size: 10px;
    letter-spacing: 1.6px;
    line-height: 1.5;
    text-align: left;
  }
  main .hero .apresentacao > h1 {
    grid-column: 2;
    grid-row: 2;
    align-self: start;
    margin: 0;
    font-size: clamp(29px, 7.4vw, 41px) !important;
    line-height: 1.12;
    letter-spacing: -.028em;
    text-align: left;
    overflow-wrap: normal;
  }
  main .hero .apresentacao > .frase {
    grid-column: 1 / -1;
    grid-row: 3;
    max-width: none;
    width: 100%;
    margin: 23px 0 18px;
    padding: 4px 0 4px 16px;
    background: transparent;
    border: 0;
    border-left: 3px solid #53675A;
    border-radius: 0;
    font-size: clamp(17px, 4.45vw, 19px);
    line-height: 1.6;
    text-align: left;
    hyphens: none;
    overflow-wrap: break-word;
    text-wrap: pretty;
  }
  main .hero .apresentacao > .texto-paragrafos {
    grid-column: 1 / -1;
    grid-row: 4;
    width: 100%;
    max-width: 100%;
    margin: 0;
    padding: 0;
    text-align: left;
    hyphens: none;
    overflow-wrap: break-word;
    word-break: normal;
  }
  main .hero .apresentacao .texto-paragrafos > p {
    margin: 0 0 16px;
    font-size: 15.5px;
    line-height: 1.75;
    color: #665e56;
    text-align: left;
    hyphens: none;
    overflow-wrap: break-word;
    word-break: normal;
  }
  main .hero .apresentacao .texto-paragrafos > p:last-child {
    margin-bottom: 0;
  }
  main .hero .apresentacao > .link {
    grid-column: 1 / -1;
    grid-row: 5;
    justify-self: start;
    margin: 22px 0 0;
    padding-bottom: 5px;
    font-size: 13px;
    line-height: 1.6;
  }
  main .numeros {
    margin-top: 0;
    padding: 24px 0;
  }
  main .estatisticas { gap: 8px; }
  main .estatisticas strong { font-size: 27px; }
  main .estatisticas span { font-size: 11px; line-height: 1.5; }
  main .historia {
    padding: 48px 0 54px;
    gap: 8px;
  }
  main .historia h2 { margin-bottom: 6px; }
  main .historia p:not(.rotulo) {
    font-size: 15.5px;
    line-height: 1.75;
    color: #665e56;
    hyphens: none;
    overflow-wrap: break-word;
  }
  main .leituras { padding: 50px 0 57px; }
  main .cabeca-secao { gap: 10px; margin-bottom: 23px; }
  main .futuras-perfil { padding: 47px 0 54px; }
  main .outro { padding: 51px 0 57px; }
}
@media (max-width:350px) {
  main .hero.container {
    width: calc(100% - 32px);
    column-gap: 15px;
    grid-template-columns: 84px minmax(0,1fr);
  }
  main .hero .apresentacao > h1 { font-size: 28px !important; }
  main .hero .apresentacao > .frase { padding: 3px 0 3px 13px; }
}

</style>
