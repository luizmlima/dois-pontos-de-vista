---
import g from '../data/editorial/geral.json';
const path = Astro.url.pathname;
const links = [
  { href: '/', texto: g.navInicio },
  { href: '/estante', texto: g.navEstante },
  { href: '/leituras-a-dois', texto: g.navDuplas },
  { href: '/proximas-leituras', texto: g.navFuturas },
  { href: '/sobre', texto: g.navSobre },
];
---
<a class="pular-conteudo" href="#conteudo-principal">{g.pular}</a>
<header class="cabecalho-site">
  <div class="container-site topo-site">
    <a href="/" class="marca-site" aria-label={g.ariaInicio}>
      <img class="marca-simbolo" src="/imagens/logo-dois-pontos-de-vista.png" width="92" height="53" loading="eager" decoding="async" alt="" aria-hidden="true" />
      <span>{g.marcaLinha1} <small>{g.marcaLinha2}</small></span>
    </a>
    <nav class="navegacao-site" aria-label="Navegação principal">
      {links.map(link => (
        <a href={link.href} class:list={{ativo: path === link.href, 'ativo-estante': link.href === '/estante' && path.startsWith('/livros/')}} aria-current={path === link.href ? 'page' : undefined}>{link.texto}</a>
      ))}
    </nav>
    <div class="perfis-atalhos" aria-label="Perfis dos leitores">
      <a href="/autores/luiz-anselmo" aria-label={g.ariaPerfilLuiz} title="Luiz Anselmo" class:list={{ativo: path.startsWith('/autores/luiz-anselmo')}}>
        <img src="/imagens/luiz-anselmo.jpg" alt="" width="32" height="32" />
        <span class="nome-perfil">Luiz</span>
      </a>
      <a href="/autores/heloisa-marques" aria-label={g.ariaPerfilHeloisa} title="Heloísa Marques" class:list={{ativo: path.startsWith('/autores/heloisa-marques')}}>
        <img src="/imagens/heloisa-marques.jpg" alt="" width="32" height="32" />
        <span class="nome-perfil">Heloísa</span>
      </a>
    </div>
    <details class="menu-movel">
      <summary aria-label="Abrir ou fechar o menu de navegação">
        <span class="icone-menu" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>{g.menu}</span>
      </summary>
      <nav class="links-moveis" aria-label="Navegação no celular">
        {links.map(link => (
          <a href={link.href} class:list={{ativo: path === link.href}} aria-current={path === link.href ? 'page' : undefined}>{link.texto}</a>
        ))}
        <span class="menu-divisor">{g.perfisMenu}</span>
        <a class="menu-perfil" href="/autores/luiz-anselmo"><img src="/imagens/luiz-anselmo.jpg" alt="" width="29" height="29" />Luiz Anselmo</a>
        <a class="menu-perfil" href="/autores/heloisa-marques"><img src="/imagens/heloisa-marques.jpg" alt="" width="29" height="29" />Heloísa Marques</a>
      </nav>
    </details>
  </div>
</header>
<style>
  .pular-conteudo{position:absolute;z-index:100;left:16px;top:-80px;background:#312E2B;color:#fff;padding:12px 16px;text-decoration:none;border-radius:4px;font:600 14px 'DM Sans',sans-serif}.pular-conteudo:focus{top:8px}
  .cabecalho-site{border-bottom:1px solid #ddd2c1;background:#F5F0E8;color:#312E2B}
  .container-site{width:min(1120px,calc(100% - 48px));margin-inline:auto}
  .topo-site{min-height:96px;display:flex;align-items:center;justify-content:space-between;gap:15px}
  .marca-site{display:flex;align-items:center;gap:10px;color:inherit;text-decoration:none;font:600 25px/1.05 'Playfair Display',Georgia,serif;white-space:nowrap}
  .marca-site small{display:block;font-size:19px;line-height:1.15}
  .marca-simbolo{width:65px;height:40px;object-fit:contain;flex-shrink:0}
  .navegacao-site{display:flex;align-items:center;flex-wrap:nowrap;margin-left:auto;gap:clamp(9px,1.4vw,22px);font:600 13px 'DM Sans',sans-serif}
  .navegacao-site a{color:inherit;text-decoration:none;padding:10px 0;transition:color .2s}
  .navegacao-site a:hover,.navegacao-site a.ativo{color:#884C55}
  .navegacao-site a:focus-visible,.marca-site:focus-visible{outline:2px solid #884C55;outline-offset:5px;border-radius:2px}
  .perfis-atalhos{display:flex;gap:8px;align-items:center;flex:none;padding-left:9px;border-left:1px solid #d8c9bb}
  .perfis-atalhos a{display:inline-flex;align-items:center;gap:5px;min-height:40px;padding:2px 4px;border:2px solid transparent;border-radius:24px;color:inherit;text-decoration:none;font:600 12px 'DM Sans',sans-serif;white-space:nowrap;transition:border-color .2s ease,transform .2s ease}
  .perfis-atalhos a:hover,.perfis-atalhos a.ativo{border-color:#884C55;transform:translateY(-1px)}
  .perfis-atalhos a:focus-visible{outline:2px solid #884C55;outline-offset:2px}
  .perfis-atalhos img{width:32px;height:32px;object-fit:cover;border-radius:50%;flex-shrink:0}
  .perfis-atalhos .nome-perfil{display:inline-block}
  @media (min-width:971px) and (max-width:1110px){
    .perfis-atalhos{gap:3px;padding-left:6px}
    .perfis-atalhos a{gap:3px;padding-inline:2px;font-size:11px}
    .perfis-atalhos img{width:28px;height:28px}
    .navegacao-site{gap:8px;font-size:12px}
    .marca-site{font-size:22px}
    .marca-site small{font-size:17px}
    .marca-simbolo{width:57px}
    .topo-site{gap:8px}
  }
  .menu-movel{display:none}
  @media(max-width:850px){
    .topo-site{gap:15px}
    .navegacao-site{gap:10px}
    .marca-site{font-size:21px}
    .marca-site small{font-size:16px}
    .marca-simbolo{width:55px}
  }
  @media(max-width:970px){
    .container-site{width:calc(100% - 36px)}
    .topo-site{min-height:72px;padding:12px 0;flex-direction:row;justify-content:space-between;gap:12px;position:relative}
    .marca-site{font-size:clamp(17px,4.5vw,21px);gap:7px;min-width:0}
    .marca-site small{font-size:.8em}
    .marca-simbolo{width:45px;height:34px}
    .navegacao-site,.perfis-atalhos{display:none}
    .menu-movel{display:block;flex-shrink:0}
    .menu-movel summary{list-style:none;display:flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:8px 12px;border:1px solid #cfc3b4;border-radius:8px;background:#fbf7f0;color:#312E2B;cursor:pointer;font:600 13px 'DM Sans',sans-serif}
    .menu-movel summary::-webkit-details-marker{display:none}
    .menu-movel summary:focus-visible{outline:2px solid #884C55;outline-offset:3px}
    .icone-menu{display:flex;flex-direction:column;gap:4px;width:18px}
    .icone-menu i{display:block;width:18px;height:2px;background:#884C55;border-radius:3px;transition:transform .2s,opacity .2s}
    .menu-movel[open] .icone-menu i:first-child{transform:translateY(6px) rotate(45deg)}
    .menu-movel[open] .icone-menu i:nth-child(2){opacity:0}
    .menu-movel[open] .icone-menu i:last-child{transform:translateY(-6px) rotate(-45deg)}
    .links-moveis{position:absolute;top:calc(100% - 1px);left:0;right:0;z-index:50;display:flex;flex-direction:column;gap:0;padding:9px;background:#fbf7f0;border:1px solid #dfd4c6;border-radius:0 0 12px 12px;box-shadow:0 14px 24px #312e2b1a}
    .links-moveis a{display:block;padding:14px 16px;color:#312E2B;text-decoration:none;border-radius:6px;font:600 14px 'DM Sans',sans-serif}
    .links-moveis a+a{border-top:1px solid #ece4d9}
    .links-moveis a.ativo{color:#884C55;background:#f0e5e0}
    .links-moveis .menu-divisor{font:700 10px 'DM Sans',sans-serif;letter-spacing:1.6px;color:#837469;margin:13px 12px 4px;padding-top:11px;border-top:1px solid #dfd4c6}
    .links-moveis .menu-perfil{display:flex;align-items:center;gap:11px;padding:10px 14px}
    .menu-perfil img{height:29px;width:29px;border-radius:50%;object-fit:cover}
    .links-moveis a:focus-visible{outline:2px solid #884C55;outline-offset:-2px}
  }
  @media(max-width:340px){.marca-site{font-size:16px}.marca-simbolo{width:40px;height:30px}.menu-movel summary{padding:8px 10px;gap:6px}}
  @media(prefers-reduced-motion:reduce){.icone-menu i{transition:none}}
</style>
